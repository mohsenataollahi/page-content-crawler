"Project-Id-Version: Page Content Crawler 1.0.0\n"
"Language: fa_IR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"
"X-Domain: page-content-crawler\n"

msgid "Page Content Crawler"
msgstr "خزنده محتوای صفحه"

msgid "Fetches HTML from a URL, extracts one CSS selector, and stores the result and its update time on a selected page."
msgstr "HTML یک نشانی را می‌گیرد، یک عنصر را با CSS selector استخراج می‌کند، و نتیجه را همراه با تاریخ بروزرسانی روی برگه انتخاب‌شده ذخیره می‌کند."

msgid "Page Content Crawler requires PHP %s or newer."
msgstr "خزنده محتوای صفحه به PHP %s یا جدیدتر نیاز دارد."

msgid "Page Content Crawler requires WordPress %s or newer."
msgstr "خزنده محتوای صفحه به وردپرس %s یا جدیدتر نیاز دارد."

msgid "Page Content Crawler requires these PHP extensions: %s."
msgstr "خزنده محتوای صفحه به این افزونه‌های PHP نیاز دارد: %s."

msgid "Page Content Crawler is missing the vendor autoloader. Install Composer dependencies before activating it."
msgstr "فایل autoload خزنده محتوای صفحه پیدا نشد. پیش از فعال‌سازی، وابستگی‌های Composer را نصب کنید."

msgid "Storage"
msgstr "ذخیره‌سازی"

msgid "Target page"
msgstr "برگه هدف"

msgid "Choose the page that stores the extracted content and its update time."
msgstr "برگه‌ای را انتخاب کنید که محتوا و تاریخ بروزرسانی در آن ذخیره می‌شود."

msgid "— Select a page —"
msgstr "— یک برگه انتخاب کنید —"

msgid "No pages are available yet."
msgstr "هنوز برگه‌ای وجود ندارد."

msgid "Select a page that is not in the trash."
msgstr "برگه‌ای را انتخاب کنید که در زباله‌دان نباشد."

msgid "Crawl"
msgstr "کرال"

msgid "Source URL"
msgstr "نشانی منبع"

msgid "CSS selector"
msgstr "انتخابگر CSS"

msgid "Crawl interval"
msgstr "بازه زمانی کرال"

msgid "Set the URL to fetch, the element to keep, and how often the crawl runs."
msgstr "نشانی، عنصر، و بازه زمانی کرال را تنظیم کنید."

msgid "Enter a URL of %d characters or fewer."
msgstr "نشانی را حداکثر در %d نویسه وارد کنید."

msgid "Enter a valid http or https URL."
msgstr "یک نشانی معتبر http یا https وارد کنید."

msgid "Enter a CSS selector without HTML."
msgstr "انتخابگر CSS را بدون HTML وارد کنید."

msgid "Enter a CSS selector of %d characters or fewer."
msgstr "انتخابگر CSS را حداکثر در %d نویسه وارد کنید."

msgid "Number of minutes between crawls. 0 turns the crawl off. 5 runs every 5 minutes."
msgstr "فاصله کرال به دقیقه. ۰ کرال را خاموش می‌کند. ۵ یعنی هر ۵ دقیقه."

msgid "Enter a whole number of minutes from 0 to %d."
msgstr "یک عدد صحیح از ۰ تا %d دقیقه وارد کنید."

msgid "Every minute"
msgstr "هر دقیقه"

msgid "Every %d minutes"
msgstr "هر %d دقیقه"
